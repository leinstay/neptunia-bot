# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Loaded by src/config.js — a plain KEY=VALUE parser (quotes and # comments
# supported), not the "dotenv" package. Values already present in the real
# process environment are never overridden by this file. Secrets are read once
# at startup; everything else lives in config.json and is hot-reloaded.

# Discord bot token (Developer Portal → Bot → Token). The bot needs the
# "Message Content" privileged intent enabled on the same page.
DISCORD_TOKEN=

# OpenRouter API key (https://openrouter.ai/keys) used for every LLM request.
OPENROUTER_API_KEY=
